{
  "name": "sewaskill",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "preview": "npm run preview -w frontend",
    "setup:env": "node scripts/setup-env.mjs",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:reset": "npm run db:reset -w backend",
    "test:backend": "npm run test -w backend",
    "test:browser": "npm run build -w backend && node scripts/browser-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.0",
    "playwright-core": "^1.58.0"
  }
}
