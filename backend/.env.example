NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://sewaskill:replace-with-your-local-password@127.0.0.1:5432/sewaskill?schema=public
TEST_DATABASE_URL=postgresql://sewaskill:replace-with-your-local-password@127.0.0.1:5432/sewaskill_test?schema=public
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET=replace-with-another-random-secret-at-least-32-characters
SESSION_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5174,http://127.0.0.1:5174
AUTH_IP_LIMIT=300
AUTH_ACCOUNT_LIMIT=30

# Images use a persistent folder; exclude it from deployments that delete releases.
STORAGE_DIR=storage/uploads
# Demo balance payments are local-only. Set false on server.
PAYMENT_DEMO_ENABLED=true
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
